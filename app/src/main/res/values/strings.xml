    <!-- AboutScreen -->
    <string name="about_title">About &amp; Privacy</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy_title">Privacy First</string>
    <string name="about_privacy_body">This app is fully offline. It has no network permission, no analytics, no tracking, and no crash reporting. All text and image sanitization happens entirely on your device.</string>
    <string name="about_image_title">How Images are Sanitized</string>
    <string name="about_image_body">When you sanitize an image, Share Sanitizer reads the raw pixel data and saves it to a brand new file. This ensures that EXIF metadata (like GPS location, camera model, date/time taken) is completely dropped. Your original files are never overwritten.</string>
    <string name="about_text_title">How Text is Sanitized</string>
    <string name="about_text_body">Share Sanitizer looks for URLs in your shared text. It removes common tracking parameters and applies bundled offline Community URL Rules for domain-specific cleanup, while preserving functional link parameters whenever possible.</string>
    <string name="about_text_rules_note">Community URL Rules are based on an offline snapshot of the ClearURLs Rules database, licensed under LGPL-3.0.</string>
    <string name="about_open_source_title">Open Source</string>
    <string name="about_open_source_body">This application is free and open-source software, licensed under the GNU General Public License v3.0 (GPL-3.0). You can review the source code to verify these privacy claims.</string>
    <string name="about_view_source">View Source Code →</string>
